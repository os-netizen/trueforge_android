{
  "name": "trueforge-android",
  "private": true,
  "version": "0.1.0",
  "description": "Governed computer use agent for Android: Kotlin device runtime + TypeScript bridge + TrueForge agent harness",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "smoke:trueforge": "npm run smoke --workspace @trueforge-android/server",
    "eval:android": "npm run eval --workspace @trueforge-android/server --",
    "eval:phone": "npm run eval:phone --workspace @trueforge-android/server --",
    "test:eval": "npm run test:eval --workspace @trueforge-android/server",
    "test:dashboard": "npm run test --workspace dashboard",
    "dev:server": "npm run dev --workspace @trueforge-android/server",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "dependencies": {
    "ws": "^8.21.3"
  }
}

# Copy to .env and adjust as needed. All have sensible defaults for local dev.

# Local TrueForge runtime (npx @truefoundry/trueforge)
TRUEFORGE_BASE_URL=http://127.0.0.1:8790

# This bridge process's MCP endpoint host/port
BRIDGE_MCP_HOST=127.0.0.1
BRIDGE_MCP_PORT=8791

# OpenCode Go model provider registration
MODEL_PROVIDER_NAME=opencode-go
MAIN_MODEL_ID=deepseek-v4-flash
VISION_MODEL_ID=deepseek-v4-flash-vision-exp

# Agent name registered in TrueForge
AGENT_NAME=android-operator-dev

# API key override; defaults to reading ~/.local/share/opencode/auth.json (opencode-go entry)
# OPENCODE_GO_API_KEY=
